---
import { indice } from '../../../lib/dati.mjs';
import Base from '../../../layouts/Base.astro';
import Griglia from '../../../components/Griglia.astro';

export async function getStaticPaths({ paginate }) {
  const foto = indice();
  const temi = [...new Set(foto.flatMap((r) => r[3]))];
  return temi.flatMap((tema) =>
    paginate(foto.filter((r) => r[3].includes(tema)), { params: { tema }, pageSize: 100 }));
}
const { page } = Astro.props;
---
<Base titolo={Astro.params.tema}>
  <h1>{Astro.params.tema} — pagina {page.currentPage}/{page.lastPage}</h1>
  <Griglia foto={page.data} />
  {page.url.next && <a href={page.url.next}>Avanti</a>}
</Base>
