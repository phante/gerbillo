---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Griglia from '../../../components/Griglia.astro';

export async function getStaticPaths({ paginate }) {
  const foto = await getCollection('foto');
  const temi = [...new Set(foto.flatMap((f) => f.data.temi))];
  return temi.flatMap((tema) =>
    paginate(foto.filter((f) => f.data.temi.includes(tema)), { params: { tema }, pageSize: 100 }));
}
const { page } = Astro.props;
---
<Base titolo={Astro.params.tema}>
  <h1>{Astro.params.tema} — pagina {page.currentPage}/{page.lastPage}</h1>
  <Griglia foto={page.data} />
  {page.url.next && <a href={page.url.next}>Avanti</a>}
</Base>
