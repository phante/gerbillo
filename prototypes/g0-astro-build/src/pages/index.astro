---
import Base from '../layouts/Base.astro';
import { indice } from '../lib/dati.mjs';

// ponytail: nei blocchi Foto la home viene rigenerata vuota e poi sovrascritta dal blocco indici
const foto = indice();
const temi = [...new Set(foto.flatMap((r) => r[3]))];
---
<Base titolo="Gallery">
  <h1>{foto.length} foto</h1>
  <ul>{temi.map((t) => <li><a href={`/gallery/tema/${encodeURIComponent(t)}/`}>{t}</a></li>)}</ul>
</Base>
