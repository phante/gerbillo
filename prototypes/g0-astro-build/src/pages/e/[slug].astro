---
import { indice } from '../../lib/dati.mjs';
import Base from '../../layouts/Base.astro';
import Griglia from '../../components/Griglia.astro';

export async function getStaticPaths() {
  const perEntita = new Map();
  for (const r of indice())
    for (const s of r[2]) perEntita.has(s) ? perEntita.get(s).push(r) : perEntita.set(s, [r]);
  return [...perEntita].map(([slug, foto]) => ({ params: { slug }, props: { foto } }));
}
const { foto } = Astro.props;
const { slug } = Astro.params;
---
<Base titolo={slug}>
  <h1>{slug} ({foto.length} foto)</h1>
  <Griglia foto={foto} />
</Base>
